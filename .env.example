# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# Neon PostgreSQL connection string (pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Bill scanning (optional). Without a key the "Scan a bill" button is switched off.
# Key from Google AI Studio. On the free tier Google may use what is sent to improve
# its products and people may review it; the paid tier does not. See docs/bill-scanning.md.
GEMINI_API_KEY=""
# Optional: the Gemini model that reads bills. Leave empty for the default.
BILL_SCAN_MODEL=""
